# CID Portal — Supabase (publishable key only; public by design, RLS protects data).
# Placeholders only in this file — real values live in the Vercel dashboard
# (scoped per environment: Production = live project, Preview = staging project)
# and in a git-ignored .env.local for local development. See docs/DEPLOYMENT.md §1.
NEXT_PUBLIC_SUPABASE_URL=PASTE_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_PUBLISHABLE_KEY

# FiveManage media hosting (Media Vault + Case Files uploads). The key is
# referrer-bound and browser-exposed by design, but it is still NOT committed
# here — set it in the Vercel dashboard / .env.local. With a PASTE_ placeholder
# the app degrades to the paste-a-URL fallback (fmConfigured() gate).
NEXT_PUBLIC_FIVEMANAGE_API_KEY=PASTE_FIVEMANAGE_KEY
NEXT_PUBLIC_FIVEMANAGE_BASE_URL=https://api.fivemanage.com

# Portal Assistant (owner-only pilot, page-agent). OPTIONAL and INERT by
# default: leave these unset and the assistant loads nothing and makes no
# external calls. Set all three to enable it FOR OWNERS ONLY. The key is
# exposed to the browser (NEXT_PUBLIC_) — use a restricted / proxy key, never a
# privileged one — and on-screen content is sent to the model, so don't use it
# on restricted/sealed records. See docs/DEV-TOOLING.md.
NEXT_PUBLIC_PAGE_AGENT_MODEL=
NEXT_PUBLIC_PAGE_AGENT_BASE_URL=
NEXT_PUBLIC_PAGE_AGENT_API_KEY=

# ---- Platform upgrade (all OPTIONAL — the portal works with every one unset) ----

# Error tracking (Sentry, browser SDK). Loaded lazily by src/lib/errorReport.ts
# only when the DSN is set; `client_errors` stays the primary record. Events
# are scrubbed before they leave the browser (no bodies, cookies, headers,
# query strings, narratives or CI numbers). NEXT_PUBLIC_SENTRY_ENV names the
# environment (production / preview / development).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=

# OpenTelemetry (server side only). src/instrumentation.ts registers
# @vercel/otel with serviceName "cid-portal" ONLY when this endpoint is set;
# nothing is exported otherwise. Never a NEXT_PUBLIC_ variable.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Evidence storage host. `supabase` (default) uploads to the private
# case-evidence bucket with a client SHA-256 and registers the file through
# evidence_register; `fivemanage` keeps the legacy host as the primary path.
NEXT_PUBLIC_EVIDENCE_HOST=supabase

# Feature-flag overrides. Each flag lives in the feature_flags table (Owner
# Console → System Health); `on` / `off` here wins over the row for THIS
# build (preview deployments exercising an optional service). Unset = the
# row decides. Names only — never a value that widens access.
NEXT_PUBLIC_ENABLE_STIRLING_PDF=
NEXT_PUBLIC_ENABLE_CRAWL4AI=
NEXT_PUBLIC_ENABLE_DOCUMENT_PROCESSING=
NEXT_PUBLIC_ENABLE_ADVANCED_GRAPH=
NEXT_PUBLIC_ENABLE_MEILISEARCH=
NEXT_PUBLIC_ENABLE_SEMANTIC_SEARCH=
NEXT_PUBLIC_ENABLE_EVIDENCE_SEALING=
NEXT_PUBLIC_ENABLE_OPENFGA=
NEXT_PUBLIC_ENABLE_ADVANCED_EDITOR=
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=
