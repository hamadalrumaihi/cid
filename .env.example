# CID Portal — Supabase (publishable key only; public by design, RLS protects data).
# Placeholders only in this file — real values live in the Vercel dashboard
# (scoped per environment: Production = live project, Preview = staging project)
# and in a git-ignored .env.local for local development. See docs/DEPLOYMENT.md §1.
NEXT_PUBLIC_SUPABASE_URL=PASTE_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_PUBLISHABLE_KEY

# FiveManage media hosting (Media Vault + Case Files uploads). The key is
# referrer-bound and browser-exposed by design, but it is still NOT committed
# here — set it in the Vercel dashboard / .env.local. With a PASTE_ placeholder
# the app degrades to the paste-a-URL fallback (fmConfigured() gate).
NEXT_PUBLIC_FIVEMANAGE_API_KEY=PASTE_FIVEMANAGE_KEY
NEXT_PUBLIC_FIVEMANAGE_BASE_URL=https://api.fivemanage.com

# Portal Assistant (owner-only pilot, page-agent). OPTIONAL and INERT by
# default: leave these unset and the assistant loads nothing and makes no
# external calls. Set all three to enable it FOR OWNERS ONLY. The key is
# exposed to the browser (NEXT_PUBLIC_) — use a restricted / proxy key, never a
# privileged one — and on-screen content is sent to the model, so don't use it
# on restricted/sealed records. See docs/DEV-TOOLING.md.
NEXT_PUBLIC_PAGE_AGENT_MODEL=
NEXT_PUBLIC_PAGE_AGENT_BASE_URL=
NEXT_PUBLIC_PAGE_AGENT_API_KEY=
