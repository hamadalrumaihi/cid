{
  // Dead-export / dead-dependency gate (P2-4): `npm run check:dead`.
  // Entries come from knip's Next.js / Playwright / Vitest plugins (app
  // router pages, playwright*.config.ts + tests, vitest configs), so no
  // manual `entry` list is needed — it tracks the repo layout automatically.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // MSW browser worker: inert until the Storybook phase (src/mocks/browser.ts
    // header) — nothing imports it yet, but it is a deliberate entry point of
    // the mock layer, not dead code. The vitest plugin picks up the node side
    // (src/mocks/server.ts via tests/msw/setup.ts) automatically.
    "src/mocks/browser.ts",
    // next/navigation stub for Storybook's Vite builder: reached only through
    // the resolve.alias in .storybook/main.ts, which knip's import graph
    // can't follow. (The storybook plugin handles .storybook/* and *.stories.*
    // automatically.)
    ".storybook/mocks/next-navigation.ts",
    // Wired dashboard switcher (Phase-1A): its presentational core
    // (DashSwitcherView) is consumed by the Sidebar and Storybook today; the
    // wired component mounts in the Phase-1B dashboard views.
    "src/components/dash/DashSwitcher.tsx"
  ],
  "ignore": [
    // Generated TypeScript mirror of the live schema — exports exist for
    // completeness, not for use.
    "src/lib/database.types.ts",
    // Deno edge functions: deployed to Supabase, never imported by the app.
    "supabase/functions/**",
    // Standalone city-developer handoff (docs/integration/CID-INTEGRATION-API.md):
    // self-contained contract types + Node mock, deliberately never imported
    // by the app — same "not app code" rationale as supabase/functions/**.
    "integration-package/**"
  ],
  "ignoreBinaries": [
    "semgrep", // installed ad hoc in code-quality.yml (pip), not an npm bin
    "lhci", // run via `npx --yes @lhci/cli` in code-quality.yml
    "psql" // scripts/test-seed.mjs shells out to the system Postgres client
  ],
  // An export used elsewhere in its own module is not dead code.
  "ignoreExportsUsedInFile": true
}
