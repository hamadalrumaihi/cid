{
  "name": "web",
  "version": "1.18.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:seed": "node scripts/test-seed.mjs",
    "sast": "semgrep scan --config p/typescript --config p/react --config p/nextjs --config p/secrets --error --metrics=off",
    "perf": "lhci autorun --config=lighthouserc.json",
    "typecheck": "tsc --noEmit",
    "assistant:proxy": "node scripts/page-agent-proxy.mjs",
    "gen:handbook": "node scripts/generate-handbook.mjs",
    "gen:guide": "node scripts/generate-guide.mjs",
    "check:schema": "node scripts/check-schema-sync.mjs",
    "check:dead": "knip",
    "check:submit": "node scripts/check-submit-buttons.mjs",
    "check:freshness": "node scripts/check-snapshot-freshness.mjs",
    "check:realtime": "node scripts/check-realtime.mjs",
    "check:notif-titles": "node scripts/sync-notification-titles.mjs --check",
    "sync:notif-titles": "node scripts/sync-notification-titles.mjs",
    "gen:snapshot": "node scripts/build-schema-snapshot.mjs",
    "gen:permissions": "node scripts/gen-permissions-matrix.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "import:cid-general": "node scripts/import-cid-general.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/browser": "^10.74.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-table": "^3.27.3",
    "@tiptap/extension-table-cell": "^3.27.3",
    "@tiptap/extension-table-header": "^3.27.3",
    "@tiptap/extension-table-row": "^3.27.3",
    "@tiptap/extension-underline": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@uppy/core": "^5.2.0",
    "@uppy/xhr-upload": "^5.2.0",
    "@vercel/otel": "^2.1.3",
    "cytoscape": "^3.34.3",
    "cytoscape-fcose": "^2.2.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.10",
    "page-agent": "^1.12.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cytoscape": "^3.21.9",
    "@types/cytoscape-fcose": "^2.2.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "happy-dom": "^20.11.1",
    "knip": "^6.26.0",
    "msw": "^2.15.0",
    "storybook": "^10.5.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
