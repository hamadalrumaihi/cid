# CID Portal — docker-compose / Coolify environment (values intentionally blank).
# Copy to .env next to docker-compose.yml. Only the worker reads the Supabase
# values; never put the service-role key anywhere the browser can reach.
# The Vercel-hosted app needs none of these.

# --- required ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MEILI_MASTER_KEY=

# --- worker identity / throughput ---
WORKER_NAME=
JOB_CONCURRENCY_PDF=
JOB_CONCURRENCY_CRAWLER=
JOB_CONCURRENCY_DOCUMENTS=
JOB_CONCURRENCY_EVIDENCE=
JOB_CONCURRENCY_EXPORTS=
JOB_CONCURRENCY_SEARCH=
JOB_CONCURRENCY_EMBEDDINGS=
JOB_CONCURRENCY_HEALTH=
JOB_RATE_CRAWLER=

# --- transport (leave blank to run the worker in-process without Redis) ---
REDIS_URL=

# --- auxiliary services (compose defaults point at the sibling containers) ---
STIRLING_URL=
STIRLING_API_KEY=
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=
DOCLING_URL=
DOCLING_API_KEY=
MEILI_URL=

# --- embeddings (OpenAI-compatible; 1536-dim model required) ---
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=

# --- telemetry (optional) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
